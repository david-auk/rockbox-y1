# Theme: crowPod
# Version 1.0
# Last Update: 06/25/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Crow theme!! All pixel art is by me. The picture on the menu changes according to the time of day (changes at 8 AM, 2 PM, and 6 PM). 
# Code based on: bunnyPod by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo! Credits to J. Adler for ProFont-CJK. Other fonts used are Bitstream Cyberbit and LanaPixel by eishiya. Also inspired by RatPod by Jannis Bolzern! 
# Caw caw!

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(6,07-LanaPixel.fnt)
%Fl(7,14-LanaPixel.fnt)
%Fl(9,23-Cyberbit.fnt)

#Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0,5)
%xl(music_note,music_note.bmp,0,0)
%xl(crow_sbs,crow_sbs.bmp,0,0,4)
%xl(crow_usb,crow_usb.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)>>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,10,45,200,170,7)

# Time
%Vl(mainMenu,220,50,95,20,9)
%ac%?cf<%cH|%cl>:%cM%?cf<|%cP>%Vs(invert)

# Line
%Vl(mainMenu,5,36,310,1,-)
%dr(0,0,310,2)

# SBS Icon - crow scene changes with the 24-hour clock (%cH).
# 21:00-05:59 night (1), 06:00-08:59 sunrise (2),
# 09:00-17:59 day (3), 18:00-20:59 sunset (4).
%Vl(mainMenu,220,80,95,140,-)
%?if(%cH, <, 6)<%xd(crow_sbs,1)|%?if(%cH, <, 9)<%xd(crow_sbs,2)|%?if(%cH, <, 18)<%xd(crow_sbs,3)|%?if(%cH, <, 21)<%xd(crow_sbs,4)|%xd(crow_sbs,1)>>>>

# Play/Pause Icons
%Vl(mainMenu,10,7,22,22,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|%xd(playmodes,1)>

# Shuffle Icon
%Vl(mainMenu,38,6,25,22,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,70,7,26,22,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold
%Vl(mainMenu,220,12,40,15,6)
%ac%?mh<HOLD%Vs(invert)|>

# Battery Icon
%Vl(mainMenu,265,10,22,18,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Disk
%Vl(mainMenu,290,10,20,20,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

%Vl(mainMenu,5,216,16,16,-)
%Cl(1,1,14,14,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>|>
%?if(%mp, >, 1)<%?C<%dr(0,0,16,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,15,16,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,1,1,14)>|>
%?if(%mp, >, 1)<%?C<%dr(15,1,1,14)>|>

# Now Playing
%Vl(mainMenu,25,216,290,16,6)
%?if(%mp, >, 1)<%s%?it<%it|%fn>%?ia< - %ia>|>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,10,45,200,170,6)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,320,240,-)

# Time / Battery (numerical)
%Vl(usbScreen,10,10,240,25,6)
%al%?cf<%al%cH|%cl>:%cM%?cf<| %cP>

# Battery Level
%Vl(usbScreen,260,10,30,12,6)
%ar%bl%%

# Battery
%Vl(usbScreen,290,10,22,18,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,5,36,310,2,-)
%dr(0,0,310,2)

%Vl(usbScreen,45,90,230,140,-)
%xd(crow_usb)

# USB Text
%Vl(usbScreen,10,40,300,25,7)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,10,70,300,14,6)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac
