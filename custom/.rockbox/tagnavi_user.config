#! rockbox/tagbrowser/2.0

# Sort internally by disc + track, but display title only.
%format "fmt_title" "%03d%03d%s" discnum tracknum title %strip = "6"

# Media type 1 is assigned to files under /Library/Music.
%menu_start "music" "Music"
# "Artists" -> canonicalartist ? mediatype = "1" -> album -> title = "fmt_title"
"Artists" -> albumartist ? mediatype = "1" -> album -> title = "fmt_title"
"Genres" -> genre ? mediatype = "1" -> canonicalartist -> album -> title = "fmt_title"
"Shuffle Songs" ~> title = "fmt_title" ? mediatype = "1"

# Media type 2 is assigned to files under /Library/Podcasts.
# Show = album, author = canonical artist, episode = title.
%menu_start "podcasts" "Podcasts"
"Shows" -> album ? mediatype = "2" -> title = "fmt_title"
"Authors" -> canonicalartist ? mediatype = "2" -> album -> title = "fmt_title"
"Episodes" -> title = "fmt_title" ? mediatype = "2"

# Top-level database navigation.
%menu_start "main" "Media"
"Music" ==> "music"
"Podcasts" ==> "podcasts"

%root_menu "main"
